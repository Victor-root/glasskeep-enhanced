<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode counterpart of values/themes.xml. The light version has
         no explicit android:windowBackground, so it inherits white from
         AppCompat.Light - fine there, but with no night override at all,
         the OS-generated splash screen (derived from this theme, before
         Compose ever draws a frame) stayed on that light background even
         with the device in dark mode. android:windowBackground here
         matches DarkBgColor (SetupScreen.kt) / the dark onboarding bars
         (SystemBarScrim.kt's own "#1a1a1a"), so the splash and the first
         frame agree with the rest of the app in dark mode. -->
    <style name="Theme.GlassKeep" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#1a1a1a</item>
    </style>
</resources>
