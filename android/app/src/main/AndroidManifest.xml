<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- In-app self-update: fetch the latest APK from GitHub Releases,
         drop it into our private cache, then hand it to Android's
         system installer via the FileProvider declared below. The user
         has to flip "Install unknown apps" for GlassKeep once; after
         that, future updates trigger the native "Update?" dialog
         straight from a background check on launch. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The self-updater posts a non-intrusive notification when a new
         release is available; tap-to-download. Runtime grant required
         on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Local reminder alarms (note-reminders feature). Exact alarms make a
         reminder fire on time even in Doze; USE_EXACT_ALARM is the Android
         13+ form (auto-granted for reminder/alarm apps), SCHEDULE_EXACT_ALARM
         the 31–32 form. RECEIVE_BOOT_COMPLETED re-arms pending alarms after a
         reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app ask (once) to be exempted from battery optimization so
         the background reminder sync + exact alarms aren't killed by
         aggressive OEM power management. The user can decline. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- TV support: declare leanback as optional and touchscreen as not required so
         the same APK can be installed on phones, tablets AND Android TV devices
         (Nvidia Shield, Chromecast with Google TV, etc). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!-- usesCleartextTraffic below: unencrypted traffic stays possible at
         the platform level because reaching a server on your own network
         by its address, with no certificate, is a first-class way to run
         GlassKeep. It is no longer a blanket permission: which addresses
         may be reached in the clear is decided by net/CleartextPolicy,
         applied where the address is chosen (ui/SetupScreen), where a
         stored one is reused (MainActivity, WebViewActivity) and where
         the session token is sent in the background (ReminderSyncWorker).
         An address pointing at the open internet is refused.

         The rule cannot live in res/xml/network_security_config.xml,
         where a reader would look for it: that file matches destinations
         by name and matches IP literals literally, so "the private
         ranges" is not something it can express, and the private ranges
         are exactly the case that has to keep working. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassKeep"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Show in the Android TV "Apps" row alongside touch launchers. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Long-press the launcher icon → "Scan PC login" shortcut.
                 See res/xml/shortcuts.xml + MainActivity.onCreate. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- adjustResize is what makes the framework report the keyboard as a
             WindowInsets.Type.ime() inset. Without it the mode resolves to
             adjustPan, which pans a window that has nothing to pan (the WebView
             already fills it) and reports no inset at all, so the page never
             learns the keyboard is there. The window itself is not resized:
             setDecorFitsSystemWindows(false) keeps the edge-to-edge layout and
             WebViewActivity forwards the inset to the page. -->
        <activity
            android:name=".WebViewActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Self-update FileProvider: lets us hand the downloaded APK to
             Android's system installer (ACTION_VIEW with
             application/vnd.android.package-archive) without granting
             external-storage permissions. The authority follows the
             applicationId so it stays unique across forks / build types. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Self-update notification tap target. The update-available
             notification fires this receiver with the parsed release
             metadata; the receiver kicks off the silent background
             download + system install intent. -->
        <receiver
            android:name=".update.UpdateActionReceiver"
            android:exported="false" />

        <!-- Reminder alarm target: AlarmManager fires this when a note
             reminder comes due; it posts the local notification (unless the
             app is foregrounded, where the in-app notification handles it). -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Re-arms persisted reminder alarms after a reboot. -->
        <receiver
            android:name=".reminders.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
